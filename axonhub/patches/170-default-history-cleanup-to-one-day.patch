From: VIKINGYFY <viking.yfy@qq.com>
Date: Tue, 13 Oct 2026 20:27:48 +0800
Subject: [PATCH] storage: default all history cleanup options to one day

Enable each built-in cleanup option with one-day retention for new
instances. Keep explicit stored policy values unchanged.

Frontend UI defaults are adjusted in the package Makefile (CRLF source
cannot be reliably patched by OpenWrt's patch utility).

Base-Commit: 6c181e01fc2a49a536bed09bc96e16599ac682ad

---

--- a/internal/server/biz/system_default.go
+++ b/internal/server/biz/system_default.go
@@ -12,28 +12,28 @@
 	return []CleanupOption{
 		{
 			ResourceType: CleanupResourceRequests,
-			Enabled:      false,
-			CleanupDays:  3,
+			Enabled:      true,
+			CleanupDays:  1,
 		},
 		{
 			ResourceType: CleanupResourceUsageLogs,
-			Enabled:      false,
-			CleanupDays:  30,
+			Enabled:      true,
+			CleanupDays:  1,
 		},
 		{
 			ResourceType: CleanupResourceRequestBodies,
-			Enabled:      false,
-			CleanupDays:  7,
+			Enabled:      true,
+			CleanupDays:  1,
 		},
 		{
 			ResourceType: CleanupResourceResponseBodies,
-			Enabled:      false,
-			CleanupDays:  7,
+			Enabled:      true,
+			CleanupDays:  1,
 		},
 		{
 			ResourceType: CleanupResourceResponseChunks,
-			Enabled:      false,
-			CleanupDays:  3,
+			Enabled:      true,
+			CleanupDays:  1,
 		},
 	}
 }
--- a/internal/server/biz/system_test.go
+++ b/internal/server/biz/system_test.go
@@ -823,13 +823,13 @@
 		}
 
 		if opt.ResourceType == CleanupResourceRequestBodies {
-			require.False(t, opt.Enabled)
-			require.Equal(t, 7, opt.CleanupDays)
+			require.True(t, opt.Enabled)
+			require.Equal(t, 1, opt.CleanupDays)
 		}
 
 		if opt.ResourceType == CleanupResourceResponseChunks {
-			require.False(t, opt.Enabled)
-			require.Equal(t, 3, opt.CleanupDays)
+			require.True(t, opt.Enabled)
+			require.Equal(t, 1, opt.CleanupDays)
 		}
 	}
 }
