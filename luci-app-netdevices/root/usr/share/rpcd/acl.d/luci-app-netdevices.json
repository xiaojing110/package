{
	"luci-app-netdevices": {
		"description": "Grant access to Online Devices (netdevices)",
		"read": {
			"ubus": {
				"netdevices": [ "status", "limits", "flags", "app_usage", "help" ]
			},
			"uci": [ "dhcp" ]
		},
		"write": {
			"ubus": {
				"netdevices": [ "set_static", "remove_static", "kick", "unkick", "set_limit", "remove_limit", "set_flags" ]
			},
			"uci": [ "dhcp" ]
		}
	}
}
