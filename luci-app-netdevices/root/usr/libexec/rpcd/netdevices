# ==================== rpcd 入口 ====================
case "$1" in
	list)
		cat <<'EOF'
{
  "status": {},
  "set_static": { "mac": "String", "ip": "String", "name": "String" },
  "remove_static": { "mac": "String" },
  "kick": { "mac": "String", "ip": "String" },
  "unkick": { "mac": "String" },
  "release_lease": { "mac": "String", "ip": "String" },
  "set_limit": { "mac": "String", "down": "String", "up": "String" },
  "remove_limit": { "mac": "String" },
  "limits": {},
  "set_flags": { "traffic": "String", "app_usage": "String" },
  "flags": {},
  "app_usage": { "mac": "String", "ip": "String" },
  "caps": {},
  "help": {}
}
EOF
		;;
	call)
		# 参数来源：rpcd 走 stdin；个别版本/手工调用会把 JSON 放在 $3
		IN=$(cat 2>/dev/null || true)
		if [ -z "$IN" ] && [ -n "${3:-}" ]; then IN="$3"; fi
		if [ -z "$IN" ] && [ -n "${4:-}" ]; then IN="$4"; fi
		# 取参：优先 jsonfilter，缺失时用 sed 兜底（避免单点故障）
		jget() {
			local v
			v=$(printf '%s' "$IN" | jsonfilter -e "@.$1" 2>/dev/null)
			if [ -z "$v" ] || [ "$v" = "null" ]; then
				v=$(printf '%s' "$IN" | sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
			fi
			if [ -z "$v" ] || [ "$v" = "null" ]; then
				v=$(printf '%s' "$IN" | sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p')
			fi
			printf '%s' "$v"
		}
		case "$2" in
			status)         do_status ;;
			set_static)     do_set_static    "$(jget mac)" "$(jget ip)" "$(jget name)" ;;
			remove_static)  do_remove_static "$(jget mac)" ;;
			kick)           do_kick          "$(jget mac)" "$(jget ip)" ;;
			unkick)         do_unkick        "$(jget mac)" ;;
			release_lease)  do_release_lease "$(jget mac)" "$(jget ip)" ;;
			set_limit)      do_set_limit     "$(jget mac)" "$(jget down)" "$(jget up)" ;;
			remove_limit)   do_remove_limit  "$(jget mac)" ;;
			limits)         do_limits ;;
			set_flags)      do_set_flags     "$(jget traffic)" "$(jget app_usage)" ;;
			flags)          do_flags ;;
			app_usage)      do_app_usage     "$(jget mac)" "$(jget ip)" ;;
			caps)           do_caps ;;
			help)           do_help ;;
			*)              printf '{"result":false,"error":"unknown method"}' ;;
		esac
		;;
	*)
		echo "usage: $0 {list|call <method>}" >&2
		exit 1
		;;
esac
