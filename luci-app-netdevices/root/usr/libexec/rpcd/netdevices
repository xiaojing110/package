#!/bin/sh
# ============================================================
#  netdevices —— rpcd 执行后端
#
#  ubus 对象 netdevices：
#    status          设备列表（IPv4/IPv6/MAC/在线时长/上线时间/设备名/流量/封锁/限速）
#    set_static      设置 DHCP 静态地址
#    remove_static   移除静态地址
#    kick            踢掉设备（MAC 封锁 + 挡 DHCP 续租 + 踢 DHCP + WiFi 去关联）
#    unkick          解除封锁
#    release_lease   只释放 DHCP 租约（让设备重新申请地址）
#    set_limit       设置网速限制（上行/下行 kbit/s）
#    remove_limit    移除限速
#    limits          当前限速列表
#    set_flags       功能开关（流量统计 / app 使用记录）
#    flags           读取开关
#    app_usage       【测试】按服务类型统计设备流量
#    help            使用说明
#
#  兼容 OpenWrt 23.05 / 24.10 / 25.12 / snapshot（busybox ash + busybox awk）
# ============================================================

STATE_DIR=/tmp/netdevices
FIRST_SEEN="$STATE_DIR/first_seen"
LIMITS_DIR="$STATE_DIR/limits"
BAN_LIST="$STATE_DIR/banned"
FLAGS="$STATE_DIR/flags"
LEASES=/tmp/dhcp.leases
CONF=/etc/config/netdevices

mkdir -p "$STATE_DIR" "$LIMITS_DIR" 2>/dev/null
touch "$FIRST_SEEN" "$BAN_LIST" 2>/dev/null
[ -f "$LEASES" ] || : > "$LEASES"

# ---------------- 工具 ----------------
json_str() {
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' \
		-e 's/\t/\\t/g' -e 's/\r//g' | tr -d '\n'
}
lower() { printf '%s' "$1" | tr 'A-Z' 'a-z'; }

valid_mac() {
	printf '%s' "$1" | grep -qiE '^[0-9a-f]{2}(:[0-9a-f]{2}){5}$' || return 1
	[ "$1" = "00:00:00:00:00:00" ] && return 1
	return 0
}

# 功能开关（0=关 1=开），默认全关
# 优先读 /etc/config/netdevices（LuCI「保存 / 应用与保存」后跨重启生效），
# 回落到 /tmp/netdevices/flags（旧版本/临时状态）
flag_get() {
	local v
	if command -v uci >/dev/null 2>&1; then
		v=$(uci -q get "netdevices.settings.$1" 2>/dev/null)
	fi
	if [ -z "$v" ]; then
		v=$(sed -n "s/^$1=//p" "$FLAGS" 2>/dev/null | head -1)
	fi
	[ -z "$v" ] && v=0
	printf '%s' "$v"
}
flag_set() {
	# 先写运行态缓存，保证立即生效
	grep -v "^$1=" "$FLAGS" 2>/dev/null > "$FLAGS.t" || true
	printf '%s=%s\n' "$1" "$2" >> "$FLAGS.t"
	mv "$FLAGS.t" "$FLAGS"
	# 再持久化到 uci，避免重启后实验功能又变回关闭
	if command -v uci >/dev/null 2>&1; then
		uci -q get netdevices.settings >/dev/null 2>&1 || \
			uci -q set netdevices.settings='settings'
		uci -q set "netdevices.settings.$1=$2"
		uci -q commit netdevices >/dev/null 2>&1 || true
	fi
}

leasetime_sec() {
	local t
	t=$(command -v uci >/dev/null 2>&1 && uci -q get dhcp.@dnsmasq[0].leasetime)
	case "$t" in
		''|infinite|0) echo 43200 ;;
		*h) echo $(( ${t%h} * 3600 )) ;;
		*m) echo $(( ${t%m} * 60 )) ;;
		*s) echo "${t%s}" ;;
		*)  echo "$t" ;;
	esac
}

# LAN 网桥名
lan_if() {
	local d
	d=$(command -v uci >/dev/null 2>&1 && uci -q get network.lan.device)
	[ -z "$d" ] && d=$(command -v uci >/dev/null 2>&1 && uci -q get network.lan.ifname)
	[ -z "$d" ] && d="br-lan"
	printf '%s' "$d"
}

# ---------------- 静态地址 ----------------
static_dump() {
	command -v uci >/dev/null 2>&1 || return 0
	local i=0 mac
	while :; do
		mac=$(uci -q get "dhcp.@host[$i].mac")
		[ -z "$mac" ] && break
		printf 'S|%s|%s|%s\n' "$(lower "$mac")" \
			"$(uci -q get dhcp.@host[$i].ip)" "$(uci -q get dhcp.@host[$i].name)"
		i=$((i + 1))
	done
}

lookup_name() {
	local mac="$1" ip="$2" n
	n=$(awk -v m="$mac" 'tolower($2)==m && $4!="*" && $4!="" {print $4; exit}' "$LEASES" 2>/dev/null)
	if [ -z "$n" ] && [ -n "$ip" ] && [ -f /etc/hosts ]; then
		n=$(awk -v ip="$ip" '$1==ip {print $2; exit}' /etc/hosts 2>/dev/null)
	fi
	printf '%s' "$n"
}

# ---------------- 流量统计（tc class 计数）----------------
# 每个设备对应一个 htb class，rate 上限即限速（不限速时给一个很高的值），
# `tc -s class show` 自带 Sent N bytes —— 既做限速又拿流量，一套机制两用。
tc_root_ensure() {
	local dev="$1"
	tc qdisc show dev "$dev" 2>/dev/null | grep -q "qdisc htb 1:" && return 0
	tc qdisc add dev "$dev" root handle 1: htb default 999 >/dev/null 2>&1 || true
	tc class add dev "$dev" parent 1: classid 1:999 htb rate 10000mbit >/dev/null 2>&1 || true
}

ifb_ensure() {
	local dev="$1"
	ip link show ifb0 >/dev/null 2>&1 || ip link add ifb0 type ifb >/dev/null 2>&1 || true
	ip link set ifb0 up >/dev/null 2>&1 || true
	tc qdisc show dev "$dev" 2>/dev/null | grep -q "qdisc ingress" || \
		tc qdisc add dev "$dev" handle ffff: ingress >/dev/null 2>&1 || true
	tc filter show dev "$dev" parent ffff: 2>/dev/null | grep -q ifb0 || \
		tc filter add dev "$dev" parent ffff: protocol all u32 match u32 0 0 \
			action mirred egress redirect dev ifb0 >/dev/null 2>&1 || true
	tc_root_ensure ifb0
}

# 每 MAC 的 class id = 十进制后两段，简单哈希避免冲突
mac2class() {
	# 取 MAC 后 3 字节当十六进制散列，纯 awk 实现（busybox printf '0x' 与
	# gawk 的 strtonum 都不可靠）
	printf '%s' "$1" | tr -d ':' | tail -c 6 | awk '
		{
			s = tolower($0); n = 0
			for (i = 1; i <= length(s); i++) {
				d = index("0123456789abcdef", substr(s, i, 1)) - 1
				if (d < 0) d = 0
				n = n * 16 + d
			}
			print (n % 50000) + 2
		}'
}

# 建/改某 MAC 的 class（rate 单位 kbit/s，0 = 不限速）
tc_class_set() {
	local dev="$1" mac="$2" kbit="$3" cls
	cls=$(mac2class "$mac")
	tc_root_ensure "$dev"
	if [ -z "$kbit" ] || [ "$kbit" = "0" ]; then
		tc class replace dev "$dev" parent 1: classid "1:$cls" htb rate 10000mbit >/dev/null 2>&1 || \
			tc class add    dev "$dev" parent 1: classid "1:$cls" htb rate 10000mbit >/dev/null 2>&1 || true
	else
		tc class replace dev "$dev" parent 1: classid "1:$cls" htb rate "${kbit}kbit" ceil "${kbit}kbit" >/dev/null 2>&1 || \
			tc class add    dev "$dev" parent 1: classid "1:$cls" htb rate "${kbit}kbit" ceil "${kbit}kbit" >/dev/null 2>&1 || true
	fi
	# filter 的 replace 在旧 iproute2 上没有，先删再加
	tc filter del dev "$dev" parent 1: protocol all prio 1 u32 match ether src "$mac" flowid "1:$cls" >/dev/null 2>&1 || true
	tc filter add dev "$dev" parent 1: protocol all prio 1 u32 match ether src "$mac" flowid "1:$cls" >/dev/null 2>&1 || true
}

tc_class_del() {
	local dev="$1" mac="$2" cls
	cls=$(mac2class "$mac")
	tc filter del dev "$dev" parent 1: protocol all u32 match ether src "$mac" flowid "1:$cls" >/dev/null 2>&1 || true
	tc class del dev "$dev" classid "1:$cls" >/dev/null 2>&1 || true
}

# 读取某 class 的字节数（tc -s class show）
tc_bytes() {
	local dev="$1" mac="$2" cls out
	cls=$(mac2class "$mac")
	# 注意：必须在遇到新的 class 行时重置 f，否则会读到下一个 class 的 Sent
	out=$(tc -s class show dev "$dev" 2>/dev/null | awk -v c="1:$cls" '
		$1 == "class" { f = ($3 == c) }
		f && /Sent/ {
			for (i = 1; i <= NF; i++) if ($i == "Sent") { print $(i+1); exit }
		}
	')
	printf '%s' "${out:-0}"
}

# ---------------- 封锁（踢掉设备）----------------
nft_avail() { command -v nft >/dev/null 2>&1; }

# 清掉该 MAC 的邻居表项：不改，设备会一直以「在线」留在列表里，
# 看起来像「点了没反应」
neigh_flush() {
	local mac; mac=$(lower "$1")
	ip neigh show 2>/dev/null | awk -v m="$mac" '
		tolower($0) ~ m {
			for (i = 1; i <= NF; i++)
				if ($i == "dev") print $1, $(i + 1)
		}
	' | while read -r nip ndev; do
		[ -n "$nip" ] || continue
		if [ -n "$ndev" ]; then
			ip neigh del "$nip" dev "$ndev" >/dev/null 2>&1 || true
		else
			ip neigh del "$nip" >/dev/null 2>&1 || true
		fi
	done
}

# 仅 fw4 / nftables：独立表，不污染 fw4；无 iptables / fw3
nft_ensure() {
	nft_avail || return 1
	nft list table inet netdevices >/dev/null 2>&1 || \
		nft add table inet netdevices >/dev/null 2>&1 || return 1
	nft list chain inet netdevices forward >/dev/null 2>&1 || \
		nft add chain inet netdevices forward \
			'{ type filter hook forward priority -10; policy accept; }' >/dev/null 2>&1 || return 1
	# input 链用来挡住 DHCP 续租（DHCP 报文是发给路由器本机的，
	# 走 input 而不是 forward，只封 forward 时设备仍能拿到/续租地址）
	nft list chain inet netdevices input >/dev/null 2>&1 || \
		nft add chain inet netdevices input \
			'{ type filter hook input priority -10; policy accept; }' >/dev/null 2>&1 || true
	return 0
}

ban_apply() {
	local mac="$1"
	if nft_ensure; then
		nft -a list chain inet netdevices forward 2>/dev/null | grep -qi "$mac" && return 0
		nft add rule inet netdevices forward ether saddr "$mac" counter drop >/dev/null 2>&1 || true
		nft add rule inet netdevices forward ether daddr "$mac" counter drop >/dev/null 2>&1 || true
		nft add rule inet netdevices input ether saddr "$mac" udp dport 67 counter drop >/dev/null 2>&1 || true
		nft add rule inet netdevices input ether saddr "$mac" udp dport 68 counter drop >/dev/null 2>&1 || true
		neigh_flush "$mac"
		return 0
	fi
	if nft_avail && nft list table inet fw4 >/dev/null 2>&1; then
		nft add rule inet fw4 forward ether saddr "$mac" counter drop >/dev/null 2>&1 || true
		nft add rule inet fw4 forward ether daddr "$mac" counter drop >/dev/null 2>&1 || true
		nft add rule inet fw4 input ether saddr "$mac" udp dport 67 counter drop >/dev/null 2>&1 || true
		neigh_flush "$mac"
		return 0
	fi
	return 1
}

ban_remove() {
	local mac="$1" chain
	nft_avail || return 0
	for chain in forward input; do
		nft -a list chain inet netdevices "$chain" 2>/dev/null | \
			grep -i "$mac" | sed -n 's/.*handle \([0-9]*\).*/\1/p' | while read -r h; do
				nft delete rule inet netdevices "$chain" handle "$h" >/dev/null 2>&1 || true
			done
		nft -a list chain inet fw4 "$chain" 2>/dev/null | \
			grep -i "$mac" | sed -n 's/.*handle \([0-9]*\).*/\1/p' | while read -r h; do
				nft delete rule inet fw4 "$chain" handle "$h" >/dev/null 2>&1 || true
			done
	done
	return 0
}

# 踢 DHCP + 让 dnsmasq 立刻丢掉该租约
# 没有 dhcp_release 时仍然摘掉租约文件里的记录，并靠 input 链挡掉续租报文
lease_drop() {
	local mac ip dev had=0 rel=0
	mac=$(lower "$1"); ip="$2"
	[ -z "$ip" ] && ip=$(awk -v m="$mac" 'tolower($2)==m {print $3; exit}' "$LEASES" 2>/dev/null)
	dev=$(lan_if)
	grep -qi " $mac " "$LEASES" 2>/dev/null && had=1
	if [ -n "$ip" ] && command -v dhcp_release >/dev/null 2>&1; then
		dhcp_release "$dev" "$ip" "$mac" >/dev/null 2>&1 && rel=1
	fi
	if [ -f "$LEASES" ]; then
		awk -v m="$mac" 'tolower($2)!=m' "$LEASES" > "$LEASES.t" 2>/dev/null && mv "$LEASES.t" "$LEASES"
	fi
	if [ -f /var/run/dnsmasq.pid ]; then
		kill -HUP "$(cat /var/run/dnsmasq.pid 2>/dev/null)" >/dev/null 2>&1 || true
	else
		killall -HUP dnsmasq >/dev/null 2>&1 || true
	fi
	[ "$rel" = "1" ] || [ "$had" = "1" ]
}

# WiFi 去关联（把设备从 AP 上踢下）
wifi_deauth() {
	local mac="$1"
	local iw
	iw=$(command -v iw || true)
	[ -n "$iw" ] || return 0
	for d in $(ls /sys/class/net 2>/dev/null); do
		[ -d "/sys/class/net/$d/wireless" ] || continue
		"$iw" dev "$d" del_station "$mac" >/dev/null 2>&1 || true
	done
	# ubus hostapd 兜底
	ubus list 2>/dev/null | grep '^hostapd\.' | while read -r o; do
		ubus call "$o" del_client "{\"addr\":\"$mac\",\"deauth\":true,\"reason\":1}" >/dev/null 2>&1 || true
	done
}

# ---------------- 限速 ----------------
limit_get() {
	local mac="$1"
	cat "$LIMITS_DIR/$mac" 2>/dev/null
}
limit_set() {
	local mac="$1" down="$2" up="$3"
	printf '%s %s\n' "${down:-0}" "${up:-0}" > "$LIMITS_DIR/$mac"
	local dev; dev=$(lan_if)
	# 有 tc 才真正下发
	if command -v tc >/dev/null 2>&1; then
		tc_class_set "$dev" "$mac" "$up"
		ifb_ensure "$dev" && tc_class_set ifb0 "$mac" "$down"
	fi
}
limit_del() {
	local mac="$1"
	rm -f "$LIMITS_DIR/$mac"
	local dev; dev=$(lan_if)
	tc_class_del "$dev" "$mac"
	tc_class_del ifb0 "$mac"
}

# ---------------- 【测试】app 使用记录 ----------------
# 按目标端口/协议粗分类，属启发式统计（故标为测试功能）
app_dump() {
	local mac="$1" ip="$2"
	# 从 conntrack 里捞该 IP 的连接，按 dport 归类
	awk -v ip="$ip" '
		$0 ~ ("src=" ip " ") {
			svc = "other"
			for (i=1;i<=NF;i++) {
				if ($i == "dport=443")  svc = "HTTPS / 网页 / 视频"
				else if ($i == "dport=80")   svc = "HTTP / 网页"
				else if ($i == "dport=53")   svc = "DNS"
				else if ($i == "dport=853")  svc = "DoT / DNS"
				else if ($i == "dport=22")   svc = "SSH"
				else if ($i == "dport=21")   svc = "FTP"
				else if ($i == "dport=25")   svc = "SMTP / 邮件"
				else if ($i == "dport=587")  svc = "SMTP / 邮件"
				else if ($i == "dport=993")  svc = "IMAP / 邮件"
				else if ($i == "dport=1883") svc = "MQTT / IoT"
				else if ($i == "dport=5223") svc = "APNs / 推送"
				else if ($i == "dport=5228") svc = "Google 推送"
				else if ($i == "dport=8000") svc = "流媒体"
				else if ($i == "dport=8080") svc = "HTTP 代理"
				else if ($i == "dport=8443") svc = "HTTPS 服务"
				else if ($i == "dport=123")  svc = "NTP / 时间"
				else if ($i == "dport=445")  svc = "SMB / 文件共享"
				else if ($i == "dport=3389") svc = "RDP / 远程桌面"
				else if ($i == "dport=5900") svc = "VNC / 远程桌面"
			}
			# 取该条连接的字节数（回包方向）
			b = 0
			for (i=1;i<=NF;i++) if ($i ~ /^bytes=/) { split($i,a,"="); b += a[2] }
			cnt[svc] += b; n[svc]++
		}
		END {
			for (s in cnt) printf "%s|%d|%d\n", s, n[s], cnt[s]
		}
	' /proc/net/nf_conntrack 2>/dev/null
}

# ---- 运行环境探测 ----
# 不依赖 tc / kmod-ifb / iptables-nft / kmod-sch-htb / kmod-cls-u32 任何包。
# 只报告状态；缺组件时代码层降级，不给 install 命令。
do_caps() {
	local c_tc=0 c_ifb=0 c_nft=0 c_iw=0 c_dhcp=0 c_fw4=0
	command -v tc  >/dev/null 2>&1 && c_tc=1
	command -v nft >/dev/null 2>&1 && c_nft=1
	command -v iw  >/dev/null 2>&1 && c_iw=1
	command -v dhcp_release >/dev/null 2>&1 && c_dhcp=1
	if command -v ip >/dev/null 2>&1; then
		ip link show ifb0 >/dev/null 2>&1 && c_ifb=1
	fi
	[ "$c_nft" = 1 ] && nft list table inet fw4 >/dev/null 2>&1 && c_fw4=1

	printf '{"result":{"tc":%s,"ifb":%s,"htb":true,"u32":true,"nft":%s,"fw4":%s,"iptables":false,"iw":%s,"dhcp_release":%s,"limit_ready":%s,"ban_ready":%s,"missing":"","install_hint":""}}' \
		"$c_tc" "$c_ifb" "$c_nft" "$c_fw4" "$c_iw" "$c_dhcp" \
		"$([ "$c_tc" = 1 ] && echo true || echo false)" \
		"$([ "$c_nft" = 1 ] && echo true || echo false)"
}

# ==================== rpcd 方法 ====================

do_status() {
	local NOW LT
	NOW=$(date +%s)
	LT=$(leasetime_sec)

	local RAW MERGED
	RAW=$(mktemp); MERGED=$(mktemp)

	ip neigh show 2>/dev/null | awk '
		{
			ip=$1; mac=""; ifc=""; st=""
			for (i=1;i<=NF;i++) {
				if ($i=="dev") ifc=$(i+1)
				else if ($i=="lladdr") mac=tolower($(i+1))
				else if ($i=="REACHABLE"||$i=="STALE"||$i=="DELAY"||$i=="PROBE"||$i=="PERMANENT"||$i=="NOARP"||$i=="FAILED"||$i=="INCOMPLETE") st=$i
			}
			if (mac!="" && ip!="") printf "N|%s|%s|%s|%s\n", mac, ip, ifc, st
		}
	' > "$RAW"
	# /proc/net/arp 兜底补 IPv4
	[ -r /proc/net/arp ] && awk 'NR>1 {
		ip=$1; mac=tolower($4); ifc=$6
		if (mac ~ /^[0-9a-f][0-9a-f](:[0-9a-f][0-9a-f]){5}$/ && mac!="00:00:00:00:00:00" && ip!="" && ip!="0.0.0.0")
			printf "N|%s|%s|%s|%s\n", mac, ip, ifc, "REACHABLE"
	}' /proc/net/arp >> "$RAW"
	awk -F'|' '$2 ~ /^[0-9a-f][0-9a-f](:[0-9a-f][0-9a-f]){5}$/ && $2!="00:00:00:00:00:00"' "$RAW" > "$RAW.t" && mv "$RAW.t" "$RAW"

	awk -v lt="$LT" -v now="$NOW" '
		NF>=4 {
			expir=$1+0; mac=tolower($2); ip=$3; host=$4
			if (host=="*") host=""
			if (mac !~ /^[0-9a-f][0-9a-f](:[0-9a-f][0-9a-f]){5}$/) next
			if (mac=="00:00:00:00:00:00") next
			if (ip=="*"||ip=="0.0.0.0"||ip=="") next
			start=(expir>0)?(expir-lt):0
			if (start>now||start<0) start=0
			printf "L|%s|%s|%s|%s\n", mac, ip, host, start
		}
	' "$LEASES" >> "$RAW"
	static_dump >> "$RAW"

	awk -F'|' -v now="$NOW" '
		{
			tag=$1; mac=$2; if (mac=="") next
			if (!(mac in seen)) { seen[mac]=1; order[++n]=mac }
			if (tag=="N") {
				ip=$3; ifc=$4; st=$5; if (ip=="") next
				is6=(index(ip,":")>0)?1:0
				if (is6) { if(ip6[mac]=="") ip6[mac]=ip; else if(index(","ip6[mac]",",","ip",")==0) ip6[mac]=ip6[mac]","ip }
				else     { if(ip4[mac]=="") ip4[mac]=ip; else if(index(","ip4[mac]",",","ip",")==0) ip4[mac]=ip4[mac]","ip }
				if (ifc!="" && iface[mac]=="") iface[mac]=ifc
				if (st!="" && stv[mac]=="") stv[mac]=st
			} else if (tag=="L") {
				ip=$3; host=$4; start=$5+0
				if (ip!="") {
					is6=(index(ip,":")>0)?1:0
					if (is6) { if(ip6[mac]=="") ip6[mac]=ip; else if(index(","ip6[mac]",",","ip",")==0) ip6[mac]=ip6[mac]","ip }
					else     { if(ip4[mac]=="") ip4[mac]=ip; else if(index(","ip4[mac]",",","ip",")==0) ip4[mac]=ip4[mac]","ip }
				}
				if (host!="" && nm[mac]=="") nm[mac]=host
				if (start>0 && (firsts[mac]=="" || start<firsts[mac])) firsts[mac]=start
			} else if (tag=="S") {
				ip=$3; name=$4; stat[mac]=1
				if (name!="" && nm[mac]=="") nm[mac]=name
				if (ip!="") {
					is6=(index(ip,":")>0)?1:0
					if (is6) { if(ip6[mac]=="") ip6[mac]=ip; else if(index(","ip6[mac]",",","ip",")==0) ip6[mac]=ip6[mac]","ip }
					else     { if(ip4[mac]=="") ip4[mac]=ip; else if(index(","ip4[mac]",",","ip",")==0) ip4[mac]=ip4[mac]","ip }
				}
			}
		}
		END {
			for (i=1;i<=n;i++) {
				m=order[i]
				printf "%s|%s|%s|%s|%s|%s|%s|%s\n", m,ip4[m],ip6[m],nm[m],iface[m],stv[m],(firsts[m]==""?0:firsts[m]),(stat[m]?1:0)
			}
		}
	' "$RAW" > "$MERGED"
	rm -f "$RAW"

	local out="[" first=1
	local mac ip4 ip6 nm ifc st start stt fs name uptime online banned limit_down limit_up rx tx
	local DEV; DEV=$(lan_if)

	while IFS='|' read -r mac ip4 ip6 nm ifc st start stt; do
		[ -z "$mac" ] && continue
		name="$nm"; [ -z "$name" ] && name=$(lookup_name "$mac" "${ip4%%,*}")

		fs=$(awk -v m="$mac" '$1==m{print $2;exit}' "$FIRST_SEEN" 2>/dev/null)
		if [ -z "$fs" ] || [ "$fs" = "0" ]; then
			if [ -n "$start" ] && [ "$start" != "0" ]; then fs="$start"; else fs="$NOW"; fi
			awk -v m="$mac" '$1!=m' "$FIRST_SEEN" 2>/dev/null > "$FIRST_SEEN.t"
			printf '%s %s\n' "$mac" "$fs" >> "$FIRST_SEEN.t"
			mv "$FIRST_SEEN.t" "$FIRST_SEEN"
		fi

		uptime=$((NOW-fs)); [ "$uptime" -lt 0 ] && uptime=0

		case "$st" in
			REACHABLE|STALE|DELAY|PROBE|PERMANENT|NOARP) online="true" ;;
			*) if [ -n "$ip4" ] || [ -n "$ip6" ]; then online="true"; else online="false"; fi ;;
		esac

		banned="false"
		grep -qi "^$mac$" "$BAN_LIST" 2>/dev/null && banned="true"

		limit_down=0; limit_up=0
		if [ -f "$LIMITS_DIR/$mac" ]; then
			read -r limit_down limit_up < "$LIMITS_DIR/$mac" || true
		fi

		rx=0; tx=0
		if [ "$(flag_get traffic)" = "1" ]; then
			tx=$(tc_bytes "$DEV" "$mac")
			rx=$(tc_bytes ifb0 "$mac")
		fi

		[ $first -eq 1 ] && first=0 || out="$out,"
		out="$out{\"mac\":\"$(json_str "$mac")\",\"name\":\"$(json_str "$name")\""
		out="$out,\"ip4\":\"$(json_str "$ip4")\",\"ip6\":\"$(json_str "$ip6")\""
		out="$out,\"interface\":\"$(json_str "$ifc")\",\"state\":\"$(json_str "$st")\""
		out="$out,\"online\":$online,\"first_seen\":${fs:-0},\"uptime\":$uptime"
		out="$out,\"is_static\":$([ "$stt" = "1" ] && echo true || echo false)"
		out="$out,\"banned\":$banned"
		out="$out,\"limit_down\":${limit_down:-0},\"limit_up\":${limit_up:-0}"
		out="$out,\"rx_bytes\":${rx:-0},\"tx_bytes\":${tx:-0}"
		out="$out}"
	done < "$MERGED"
	out="$out]"
	rm -f "$MERGED"

	local cutoff=$((NOW-2592000))
	awk -v c="$cutoff" '$2+0>=c' "$FIRST_SEEN" > "$FIRST_SEEN.t" 2>/dev/null && mv "$FIRST_SEEN.t" "$FIRST_SEEN"

	printf '{"result":%s,"flags":{"traffic":%s,"app_usage":%s}}' \
		"$out" "$(flag_get traffic)" "$(flag_get app_usage)"
}

# 让 dnsmasq 立即读取新的静态租约（走系统默认 DHCP）
# reload 只发 SIGHUP 重读 hosts 文件；失败时退化为 restart
reload_dhcp() {
	if [ -x /etc/init.d/dnsmasq ]; then
		/etc/init.d/dnsmasq reload >/dev/null 2>&1 && return 0
		/etc/init.d/dnsmasq restart >/dev/null 2>&1 && return 0
	fi
	if [ -f /var/run/dnsmasq.pid ]; then
		kill -HUP "$(cat /var/run/dnsmasq.pid 2>/dev/null)" 2>/dev/null && return 0
	fi
	killall -HUP dnsmasq 2>/dev/null && return 0
	return 1
}

valid_ipv4() {
	printf '%s' "$1" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || return 1
	local IFS=. o
	for o in $1; do
		[ "$o" -le 255 ] >/dev/null 2>&1 || return 1
	done
	return 0
}

do_set_static() {
	command -v uci >/dev/null 2>&1 || { printf '{"result":false,"error":"uci not available"}'; return; }
	local mac ip name i=0 existing eip sec old_ip released=false reloaded=false
	mac=$(lower "$1"); ip="$2"; name="$3"
	[ -z "$mac" ] && { printf '{"result":false,"error":"mac required"}'; return; }
	[ -z "$ip" ]  && { printf '{"result":false,"error":"ip required"}'; return; }
	valid_mac "$mac" || { printf '{"result":false,"error":"invalid mac"}'; return; }
	valid_ipv4 "$ip" || { printf '{"result":false,"error":"invalid ipv4"}'; return; }

	# 同一 IP 已被别的 MAC 占用时拒绝，否则 dnsmasq 会静默忽略后写入的条目
	while :; do
		existing=$(uci -q get "dhcp.@host[$i].mac")
		[ -z "$existing" ] && break
		eip=$(uci -q get "dhcp.@host[$i].ip")
		if [ "$eip" = "$ip" ] && [ "$(lower "$existing")" != "$mac" ]; then
			printf '{"result":false,"error":"ip already used by %s"}' "$(json_str "$existing")"
			return
		fi
		i=$((i + 1))
	done

	# 该 MAC 当前租约地址（写静态后立刻释放，设备续租就能拿到新地址）
	old_ip=$(awk -v m="$mac" 'tolower($2)==m {print $3; exit}' "$LEASES" 2>/dev/null)

	# 同 MAC 已存在则更新（走 dnsmasq 标准 config host）
	i=0
	while :; do
		existing=$(uci -q get "dhcp.@host[$i].mac")
		[ -z "$existing" ] && break
		if [ "$(lower "$existing")" = "$mac" ]; then
			uci -q set "dhcp.@host[$i].ip=$ip"
			[ -n "$name" ] && uci -q set "dhcp.@host[$i].name=$name"
			uci -q set "dhcp.@host[$i].dns=1"
			uci -q commit dhcp || { printf '{"result":false,"error":"uci commit failed"}'; return; }
			reload_dhcp && reloaded=true
			if [ -n "$old_ip" ] && [ "$old_ip" != "$ip" ]; then
				lease_drop "$mac" "$old_ip" && released=true
			fi
			printf '{"result":true,"action":"updated","ip":"%s","old_ip":"%s","reloaded":%s,"released":%s}' \
				"$ip" "${old_ip:-}" "$reloaded" "$released"
			return
		fi
		i=$((i + 1))
	done

	# 新增：用 uci add 返回的段名，比 @host[-1] 稳（后者并发时会指错）
	sec=$(uci -q add dhcp host)
	[ -z "$sec" ] && { printf '{"result":false,"error":"failed to add dhcp host"}'; return; }
	uci -q set "dhcp.$sec.mac=$mac"
	uci -q set "dhcp.$sec.ip=$ip"
	[ -n "$name" ] && uci -q set "dhcp.$sec.name=$name"
	uci -q set "dhcp.$sec.dns=1"
	uci -q commit dhcp || { printf '{"result":false,"error":"uci commit failed"}'; return; }
	reload_dhcp && reloaded=true
	if [ -n "$old_ip" ]; then
		lease_drop "$mac" "$old_ip" && released=true
	fi
	printf '{"result":true,"action":"added","section":"%s","ip":"%s","old_ip":"%s","reloaded":%s,"released":%s}' \
		"$sec" "$ip" "${old_ip:-}" "$reloaded" "$released"
}

do_remove_static() {
	command -v uci >/dev/null 2>&1 || { printf '{"result":false,"error":"uci not available"}'; return; }
	local mac i=0 existing
	mac=$(lower "$1"); [ -z "$mac" ] && { printf '{"result":false,"error":"mac required"}'; return; }
	while :; do
		existing=$(uci -q get "dhcp.@host[$i].mac"); [ -z "$existing" ] && break
		if [ "$(lower "$existing")" = "$mac" ]; then
			uci -q delete "dhcp.@host[$i]"
			uci -q commit dhcp || { printf '{"result":false,"error":"uci commit failed"}'; return; }
			reload_dhcp
			printf '{"result":true}'; return
		fi
		i=$((i+1))
	done
	printf '{"result":false,"error":"not found"}'
}

# ---- 踢掉设备 ----
do_kick() {
	local mac ip ok_ban=true ok_dhcp=true ok_wifi=true
	mac=$(lower "$1"); ip="$2"
	valid_mac "$mac" || { printf '{"result":false,"error":"invalid mac"}'; return; }

	grep -qi "^$mac$" "$BAN_LIST" 2>/dev/null || echo "$mac" >> "$BAN_LIST"

	ban_apply "$mac" || ok_ban=false
	lease_drop "$mac" "$ip" || ok_dhcp=false
	wifi_deauth "$mac" >/dev/null 2>&1 || ok_wifi=false
	neigh_flush "$mac"

	printf '{"result":true,"banned":true,"ban":%s,"dhcp":%s,"wifi":%s}' \
		"$ok_ban" "$ok_dhcp" "$ok_wifi"
}

# ---- 只做 DHCP：释放租约让设备重新申请地址（静态地址改完想立刻生效时用）----
do_release_lease() {
	local mac ip
	mac=$(lower "$1"); ip="$2"
	valid_mac "$mac" || { printf '{"result":false,"error":"invalid mac"}'; return; }
	[ -z "$ip" ] && ip=$(awk -v m="$mac" 'tolower($2)==m {print $3; exit}' "$LEASES" 2>/dev/null)
	lease_drop "$mac" "$ip"
	neigh_flush "$mac"
	printf '{"result":true,"ip":"%s"}' "${ip:-}"
}

do_unkick() {
	local mac
	mac=$(lower "$1"); valid_mac "$mac" || { printf '{"result":false,"error":"invalid mac"}'; return; }
	ban_remove "$mac"
	awk -v m="$mac" 'tolower($1)!=m' "$BAN_LIST" > "$BAN_LIST.t" 2>/dev/null && mv "$BAN_LIST.t" "$BAN_LIST"
	printf '{"result":true}'
}

# ---- 限速 ----
do_set_limit() {
	local mac down up
	mac=$(lower "$1"); down="$2"; up="$3"
	valid_mac "$mac" || { printf '{"result":false,"error":"invalid mac"}'; return; }
	# 不依赖 tc/kmod：有 tc 则下发，无则只存配置（代码层降级）
	limit_set "$mac" "$down" "$up"
	if command -v tc >/dev/null 2>&1; then
		printf '{"result":true,"mac":"%s","limit_down":%s,"limit_up":%s,"applied":true}' \
			"$mac" "${down:-0}" "${up:-0}"
	else
		printf '{"result":true,"mac":"%s","limit_down":%s,"limit_up":%s,"applied":false,"note":"tc not present; limit saved"}' \
			"$mac" "${down:-0}" "${up:-0}"
	fi
}
do_remove_limit() {
	local mac
	mac=$(lower "$1"); valid_mac "$mac" || { printf '{"result":false,"error":"invalid mac"}'; return; }
	limit_del "$mac"
	printf '{"result":true}'
}
do_limits() {
	local out="[" first=1 f mac d u
	for f in "$LIMITS_DIR"/*; do
		[ -f "$f" ] || continue
		mac=$(basename "$f"); read -r d u < "$f" || true
		[ $first -eq 1 ] && first=0 || out="$out,"
		out="$out{\"mac\":\"$mac\",\"limit_down\":${d:-0},\"limit_up\":${u:-0}}"
	done
	out="$out]"
	printf '{"result":%s}' "$out"
}

# ---- 开关 ----
# 返回布尔值（true/false），前端直接拿去更新开关状态
bool_of() { [ "$1" = "1" ] && printf 'true' || printf 'false'; }

do_set_flags() {
	[ -n "$1" ] && flag_set traffic "$1"
	[ -n "$2" ] && flag_set app_usage "$2"
	printf '{"result":true,"traffic":%s,"app_usage":%s,"saved":true}' \
		"$(bool_of "$(flag_get traffic)")" "$(bool_of "$(flag_get app_usage)")"
}
do_flags() {
	printf '{"result":{"traffic":%s,"app_usage":%s}}' \
		"$(bool_of "$(flag_get traffic)")" "$(bool_of "$(flag_get app_usage)")"
}

# ---- 【测试】app 使用记录 ----
do_app_usage() {
	[ "$(flag_get app_usage)" = "1" ] || { printf '{"result":[],"enabled":false}'; return; }
	local mac="$1" ip="$2" out="[" first=1 svc n b TMPX
	TMPX=$(mktemp)
	app_dump "$mac" "$ip" > "$TMPX" 2>/dev/null || true
	while IFS='|' read -r svc n b; do
		[ -z "$svc" ] && continue
		[ $first -eq 1 ] && first=0 || out="$out,"
		out="$out{\"service\":\"$(json_str "$svc")\",\"connections\":${n:-0},\"bytes\":${b:-0}}"
	done < "$TMPX"
	rm -f "$TMPX"
	out="$out]"
	printf '{"result":%s,"enabled":true}' "$out"
}

