# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.patch text eol=lf
*.tsx text eol=lf
*.ts text eol=lf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.7z binary

# dae / honk 的源码 pin：CI 里的 shell 直接 `sed` 取值，行尾必须是 LF
*.env text eol=lf
*.py text eol=lf
